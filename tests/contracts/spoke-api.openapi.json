                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "attempt": {
                    "maximum": 2147483647,
                    "minimum": 1,
                    "title": "Attempt",
                    "type": "integer"
                  },
                  "detail": {
                    "anyOf": [
                      {
                        "maxLength": 1024,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Detail"
                  },
                  "result": {
                    "anyOf": [
                      {
                        "additionalProperties": true,
                        "type": "object"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Result"
                  },
                  "status": {
                    "title": "Status",
                    "type": "string"
                  }
                },
                "required": [
                  "attempt",
                  "status"
                ],
                "title": "SettleRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SettledResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Settle",
        "tags": [
          "spoke"
        ]
      }
    },
