    "/api/spoke/v1/intents/{organization_id}/{intent_id}/observations": {
      "post": {
        "operationId": "report_api_spoke_v1_intents__organization_id___intent_id__observations_post",
        "parameters": [
          {
            "in": "path",
            "name": "organization_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Organization Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "intent_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Intent Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Authorization"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "additionalProperties": false,
                "properties": {
                  "attempt": {
                    "maximum": 2147483647,
                    "minimum": 0,
                    "title": "Attempt",
                    "type": "integer"
                  },
                  "exit_code": {
                    "anyOf": [
                      {
                        "maximum": 2147483647,
                        "minimum": -2147483648,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Exit Code"
                  },
                  "finished_at": {
                    "anyOf": [
                      {
                        "format": "date-time",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Finished At"
                  },
                  "generation": {
                    "maximum": 9223372036854775807,
                    "minimum": 1,
                    "title": "Generation",
                    "type": "integer"
                  },
                  "k8s_namespace": {
                    "anyOf": [
                      {
                        "maxLength": 63,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "K8S Namespace"
                  },
                  "oom_killed": {
                    "anyOf": [
                      {
                        "type": "boolean"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Oom Killed"
                  },
                  "phase": {
                    "pattern": "^[a-z][a-z_]{0,31}$",
                    "title": "Phase",
                    "type": "string"
                  },
                  "pod_uid": {
                    "anyOf": [
                      {
                        "maxLength": 64,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Pod Uid"
                  },
                  "reason": {
                    "anyOf": [
                      {
                        "maxLength": 255,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Reason"
                  },
                  "started_at": {
                    "anyOf": [
                      {
                        "format": "date-time",
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "title": "Started At"
                  }
                },
                "required": [
                  "generation",
                  "attempt",
                  "phase"
                ],
                "title": "ObservationRequest",
                "type": "object"
              }
            }
          },
          "required": true
        },
        "responses": {
