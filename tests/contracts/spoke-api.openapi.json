        ]
      }
    },
    "/api/spoke/v1/intents/{organization_id}/{intent_id}/ack": {
      "post": {
        "operationId": "acknowledge_api_spoke_v1_intents__organization_id___intent_id__ack_post",
        "parameters": [
          {
            "in": "path",
            "name": "organization_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Organization Id",
              "type": "string"
            }
          },
          {
            "in": "path",
            "name": "intent_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Intent Id",
              "type": "string"
            }
          },
          {
            "in": "header",
            "name": "authorization",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
