                "additionalProperties": false,
                "properties": {
                  "attempt": {
                    "maximum": 2147483647,
                    "minimum": 1,
                    "title": "Attempt",
                    "type": "integer"
                  },
                  "generation": {
                    "maximum": 9223372036854775807,
