# ── miragend — the swarm lifecycle daemon ────────────────────────────────────
# The ONE container that mounts the Docker socket and the swarm workspace
# (/opt/miragen). Everything else (miragen-mcp, mirarun) is an HTTP client of
# it on miragen-net and never touches Docker directly.
#
# The docker CLI + compose plugin are needed because agent containers are
# started with `docker compose up -d <name>` against the workspace's
# compose.yml, exactly as miragen-mcp did before this daemon existed.
#
# publish.yml builds this on main + v* tags → ghcr.io/.../miragend.

FROM docker:27-cli AS docker-cli

FROM python:3.12-slim

WORKDIR /app

COPY --from=docker-cli /usr/local/bin/docker /usr/local/bin/docker
COPY --from=docker-cli /usr/local/libexec/docker/cli-plugins/docker-compose /usr/local/libexec/docker/cli-plugins/docker-compose

COPY . /build/

# Claude Code, for `claude-code:<model>` memory model calls (the recall
# selector here, the extraction worker next to it): they run on the
# operator's subscription via CLAUDE_CODE_OAUTH_TOKEN (`claude setup-token`),
# not a metered key. Native installer, pinned; the binary is copied out of
# root's home so the unprivileged miragend user can run it. ~220 MB —
# INSTALL_CLAUDE_CODE=0 builds without it.
ARG INSTALL_CLAUDE_CODE=1
ARG CLAUDE_CODE_VERSION=2.1.280

RUN pip install --no-cache-dir "/build[daemon]" \
    && apt-get update && apt-get install -y --no-install-recommends gosu curl ca-certificates \
    && if [ "$INSTALL_CLAUDE_CODE" = "1" ]; then \
         curl -fsSL https://claude.ai/install.sh | bash -s "$CLAUDE_CODE_VERSION" \
         && cp -L /root/.local/bin/claude /usr/local/bin/claude \
         && rm -rf /root/.local/share/claude /root/.local/bin/claude \
         && claude --version; \
       fi \
    && rm -rf /var/lib/apt/lists/* \
    && adduser --disabled-password --gecos "" miragend

# Claude Code writes its config under CLAUDE_CONFIG_DIR; keep it on the state
# volume (writable by miragend) and never self-update inside the image.
ENV DISABLE_AUTOUPDATER=1 \
    CLAUDE_CONFIG_DIR=/var/lib/miragend/claude

COPY entrypoint.miragend.sh /app/entrypoint.sh
RUN chmod +x /app/entrypoint.sh

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import httpx; httpx.get('http://localhost:8000/health').raise_for_status()"

ENTRYPOINT ["/app/entrypoint.sh"]
