{
  "extraKnownMarketplaces": {
    "miragen": {
      "source": {
        "source": "github",
        "repo": "ieepirzy/miragen"
      }
    }
  },
  "enabledPlugins": {
    "miragen-memory@miragen": true
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://memory.muutto365.fi/sessions/v1/hooks/claude-code",
            "headers": {
              "Authorization": "Bearer $MIRAGEND_TOKEN"
            },
            "allowedEnvVars": [
              "MIRAGEND_TOKEN"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://memory.muutto365.fi/sessions/v1/hooks/claude-code",
            "headers": {
              "Authorization": "Bearer $MIRAGEND_TOKEN"
            },
            "allowedEnvVars": [
              "MIRAGEND_TOKEN"
            ],
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://memory.muutto365.fi/sessions/v1/hooks/claude-code",
            "headers": {
              "Authorization": "Bearer $MIRAGEND_TOKEN"
            },
            "allowedEnvVars": [
              "MIRAGEND_TOKEN"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://memory.muutto365.fi/sessions/v1/hooks/claude-code",
            "headers": {
              "Authorization": "Bearer $MIRAGEND_TOKEN"
            },
            "allowedEnvVars": [
              "MIRAGEND_TOKEN"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://memory.muutto365.fi/sessions/v1/hooks/claude-code",
            "headers": {
              "Authorization": "Bearer $MIRAGEND_TOKEN"
            },
            "allowedEnvVars": [
              "MIRAGEND_TOKEN"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://memory.muutto365.fi/sessions/v1/hooks/claude-code",
            "headers": {
              "Authorization": "Bearer $MIRAGEND_TOKEN"
            },
            "allowedEnvVars": [
              "MIRAGEND_TOKEN"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://memory.muutto365.fi/sessions/v1/hooks/claude-code",
            "headers": {
              "Authorization": "Bearer $MIRAGEND_TOKEN"
            },
            "allowedEnvVars": [
              "MIRAGEND_TOKEN"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://memory.muutto365.fi/sessions/v1/hooks/claude-code",
            "headers": {
              "Authorization": "Bearer $MIRAGEND_TOKEN"
            },
            "allowedEnvVars": [
              "MIRAGEND_TOKEN"
            ],
            "timeout": 5
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "http",
            "url": "https://memory.muutto365.fi/sessions/v1/hooks/claude-code",
            "headers": {
              "Authorization": "Bearer $MIRAGEND_TOKEN"
            },
            "allowedEnvVars": [
              "MIRAGEND_TOKEN"
            ],
            "timeout": 3
          }
        ]
      }
    ]
  }
}
