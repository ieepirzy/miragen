# ~/.config/miragend/miragend.env  (chmod 600)
#
# Loimi over the network — the SAME endpoint/principal mechanism MiraGen
# agents use. On the desktop deployment (~/.agents/memory.compose.yml)
# the operator port is published on loopback:
LOIMI_MEMORY_URL=http://127.0.0.1:8400
# The minted principal token for the principal named in sessions.yaml
# (`principal:`). Either the value or a *_FILE path — the daemon resolves
# FOO_FILE into FOO at startup and drops the _FILE variable.
LOIMI_MEMORY_TOKEN_FILE=/home/ilari/.agents/secrets/loimi_memory_token
# Optional: the store bearer (operator credential). Only needed for
# `scopes.provision: auto` — it lets the daemon create one `group` scope
# per project and grant the principal on it. Leave unset to run with
# `provision: manual` (+ `fallback_write`) instead.
LOIMI_OPERATOR_TOKEN_FILE=/home/ilari/.agents/secrets/loimi_operator
# Optional: guard the daemon's API. Unset = unauthenticated on loopback
# (the default for a local deployment). If set, install the hooks with
# `miragen-hook install ... --token-file <same file>`.
# MIRAGEND_TOKEN_FILE=/home/ilari/.config/miragend/token
# Recall selector model credentials, if sessions.yaml sets recall.model
# (e.g. DEEPSEEK_API_KEY=...). Unset = no optional-recall lane.
# OTLP traces (optional; mechanical span attributes only):
# MIRAGEN_OTLP_ENDPOINT=https://langfuse.example/api/public/otel/v1/traces
# MIRAGEN_OTLP_AUTH=Basic ...
