# Copy to .env before `docker compose up -d`. Do not commit .env.

# Bearer token guarding miragend's own HTTP API (clients send
# `Authorization: Bearer $MIRAGEND_TOKEN`). Empty means unguarded, relying
# entirely on Docker network isolation -- miragend logs a loud warning at
# startup if left unset. Set this to the same value mirarun's
# MIRARUN_MIRAGEN_TOKEN uses. Generate with: openssl rand -hex 32
MIRAGEND_TOKEN=replace-with-a-random-token

# Forwarded to every agent miragend creates, arming that agent's own /run*
# and /approvals* guard; daemon clients send it back as X-Miragen-Token when
# calling an agent directly. Generate the same way, and use a different
# value than MIRAGEND_TOKEN above (they guard different surfaces).
MIRAGEN_INTERNAL_TOKEN=replace-with-a-shared-agent-token

# Host directory miragend owns: agents/, compose.yml, exports/. Must exist
# (or be creatable) at this exact path on the Docker host -- see the volume
# comment in compose.yaml for why a bind mount is required here.
# MIRAGEN_WORKSPACE=/opt/miragen

# Image miragend spawns for new agents.
# MIRAGEN_BASE_IMAGE=ghcr.io/ieepirzy/miragen:latest

# Image for miragend itself. Override to build/pin a specific tag instead of
# the published :latest.
# MIRAGEND_IMAGE=ghcr.io/ieepirzy/miragend:latest

# Host port miragend's API listens on (bound to 127.0.0.1 only).
# MIRAGEND_PORT=8000
