# Copy to .env before `docker compose up -d`. Do not commit .env.

# Bearer token guarding miragend's own HTTP API (clients send
# `Authorization: Bearer $MIRAGEND_TOKEN`). Empty means unguarded, relying
# entirely on Docker network isolation -- miragend logs a loud warning at
# startup if left unset. Set this to the same value mirarun's
# MIRARUN_MIRAGEN_TOKEN uses. Generate with: openssl rand -hex 32
MIRAGEND_TOKEN=replace-with-a-random-token

# Forwarded to every agent miragend creates, arming that agent's own /run*
# and /approvals* guard; daemon clients send it back as X-Miragen-Token when
# calling an agent directly. Generate the same way, and use a different
# value than MIRAGEND_TOKEN above (they guard different surfaces).
MIRAGEN_INTERNAL_TOKEN=replace-with-a-shared-agent-token

# Host directory miragend owns: agents/, compose.yml, exports/. Must exist
# (or be creatable) at this exact path on the Docker host -- see the volume
# comment in compose.yaml for why a bind mount is required here.
# MIRAGEN_WORKSPACE=/opt/miragen

# Image miragend spawns for new agents.
# MIRAGEN_BASE_IMAGE=ghcr.io/ieepirzy/miragen:latest

# Image for miragend itself. Override to build/pin a specific tag instead of
# the published :latest.
# MIRAGEND_IMAGE=ghcr.io/ieepirzy/miragend:latest

# HOST port the daemon is published on (bound to 127.0.0.1 only). The
# container itself always serves 8000 — compose.yaml pins the daemon's bind
# port so this operator-side value cannot follow the wholesale .env load into
# the container and move the port every client dials.
# MIRAGEND_PORT=8000

# Max agents miragend will manage concurrently. Requests to create/import
# beyond this cap are rejected (429 agent_limit_exceeded) so a buggy or
# malicious client can't spawn containers until the host runs out of
# resources.
# MIRAGEND_MAX_AGENTS=10

# Default per-agent container resource ceiling, applied to every managed
# agent's compose service (docker compose "cpus" / "mem_limit" fields).
# MIRAGEND_AGENT_CPU_LIMIT=1.0
# MIRAGEND_AGENT_MEM_LIMIT=512m

# Env var NAMES (comma-separated) miragend forwards from its own
# environment into every agent container it creates -- for operator-specific
# credentials (tool-server bearer tokens and the like) that neither the
# *_API_KEY suffix filter nor the executor-kind auto-forward can know about.
# Setting the variable in this file is the whole job: the miragend service
# loads this file wholesale (env_file in compose.yaml), so no declaration
# lines are needed. CLAUDE_CODE_OAUTH_TOKEN does NOT belong in this list --
# see below.
# MIRAGEND_AGENT_ENV_PASSTHROUGH=

# Claude Code subscription token for claude-code executor agents: mint ONCE,
# interactively, on any machine with a browser via `claude setup-token`
# (requires a Pro/Max/Team/Enterprise plan). Valid ~1 year and only usable
# through Claude Code and the surfaces that wrap it -- treat it like a
# password, and rotate before expiry or runs stop when it lapses.
# Setting it here is the whole setup: miragend auto-forwards it to exactly
# the agents whose profile declares `executor: claude-code` -- no
# passthrough entry, and agents running anything else never see it.
# CLAUDE_CODE_OAUTH_TOKEN=
